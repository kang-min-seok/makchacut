# 공공데이터포털(data.go.kr) 마이페이지 > 데이터활용 > Open API > 활용신청 현황 > 일반 인증키(Decoding).
# 승인받은 API는 모두 이 키 하나로 호출한다. Encoding 키가 아니라 Decoding 키를 넣는다.
DATA_GO_KR_SERVICE_KEY=

# 서울 열린데이터광장(data.seoul.go.kr) 일반 인증키. 지하철 시간표 전체 조회용.
SEOUL_OPEN_DATA_KEY=

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키. 장소 검색용.
# JavaScript 키는 여기가 아니라 apps/web/.env.local 의 NEXT_PUBLIC_KAKAO_JS_KEY 에 넣는다.
KAKAO_REST_API_KEY=

# 철도데이터포털(data.kric.go.kr) > Open API > 열차별 운행시각표 활용신청 후 받은 키. 열차번호 단위 시간표용.
# data.go.kr 키와 별개다.
KRIC_SERVICE_KEY=
