{
  "name": "@makchacut/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/node-server.ts",
    "build": "tsup && node scripts/write-vercel-output.ts",
    "start": "node dist/node-server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "graph:check": "node --expose-gc --import tsx scripts/graph-check.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@makchacut/core": "workspace:*",
    "@makchacut/data": "workspace:*",
    "@makchacut/db": "workspace:*",
    "@makchacut/shared": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
