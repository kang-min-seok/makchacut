# 로컬 node-server 포트 (Vercel에서는 쓰지 않음)
PORT=8080
# 웹 프록시와 같은 값. 16자 이상 임의 문자열
ENGINE_API_KEY=change-me-to-a-long-random-string

# 수집 경로(/jobs/ingest)에서만 쓴다. 없어도 /plan은 동작한다.
# Supabase Session pooler(5432) 접속 문자열 (packages/db/.env.example 참고)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATA_GO_KR_SERVICE_KEY=
SEOUL_OPEN_DATA_KEY=
# pg_cron 호출 헤더 x-cron-secret 값. Supabase Vault ingest_cron_secret과 같은 값, 16자 이상
INGEST_CRON_SECRET=
